find_replace:
  # Replace Power Query parameter values per environment.
  # Add one entry per parameter expression in expressions.tmdl.
  - find_value: expression Database = "([^"]*)" meta
    is_regex: "true"
    replace_value:
      dev: <DEV_VALUE>
      test: <TEST_VALUE>
      prod: <PROD_VALUE>
    file_path: "**/expressions.tmdl"

